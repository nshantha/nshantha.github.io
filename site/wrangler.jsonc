// Cloudflare Worker that serves the static site in ./public.
// Deploy from this folder with `npx wrangler deploy` (or Workers Builds, root directory "site").
// The Worker also serves /api/scores (Bug2 leaderboard) and /api/posts (latest Substack posts).
{
  "name": "nitesh-fyi",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    // Run the Worker on every request so it can redirect other hostnames to nitesh.fyi.
    "run_worker_first": true
  },
  // Custom domains: Cloudflare creates the DNS records and certificates for these.
  "routes": [
    { "pattern": "nitesh.fyi", "custom_domain": true },
    { "pattern": "www.nitesh.fyi", "custom_domain": true },
    { "pattern": "nitesh.onemorelayer.dev", "custom_domain": true }
  ],
  // Bug2 leaderboard. Apply schema changes with `npx wrangler d1 migrations apply nitesh-fyi --remote`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nitesh-fyi",
      "database_id": "71eaa93c-1358-4c59-9c16-b0e7b3855508",
      "migrations_dir": "migrations"
    }
  ],
  // At most 5 leaderboard submissions per visitor per minute.
  "ratelimits": [
    { "name": "SCORE_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": true }
}
